# ABOUTME: Excludes build artifacts and non-essential files from Docker context.
# ABOUTME: Keeps context small for faster builds.

# Build artifacts
target/
build/

# IDE / editor
.idea/
.vscode/
*.swp
*.swo

# Git
.git/
.github/
.gitignore

# Docker (avoid recursive context)
Dockerfile
.dockerignore

# CI / config
.drone.yml
.direnv/
.envrc
.cache/
.mypy_cache/
.tox/

# Python bytecode
*.pyc
__pycache__/
venv/
doc/venv/

# Local dev files
tmp/
malware/
oxy/
*.sqlite

# Documentation
*.md
doc/
